# Copia este archivo a ".env" (ya está en .gitignore) y completa los valores reales.
# NUNCA pegues tokens en el chat, en un commit ni en un script.
# Las variables exportadas en el sistema tienen prioridad sobre .env.

# Solo la usa lanzar_vast.py; no se envía a la instancia.
VAST_API_KEY=reemplaza_con_tu_api_key_de_vast

# Variables del worker: se envían a la instancia.
RADIO_BASE_URL=https://radio.datadaf.com
RADIO_API_TOKEN=reemplaza_con_tu_token_secreto
HF_TOKEN=reemplaza_con_tu_token_de_huggingface_read

# Opcionales del worker (también se envían si están definidas):
# WHISPER_MODEL=large-v3
# PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
# TRANSCRIPTION_LANGUAGE=es
# POLL_INTERVAL_SECONDS=15
# HEARTBEAT_INTERVAL_SECONDS=18
# COMPUTE_TYPE=int8_float16
# WHISPER_BATCH_SIZE=12
# PYANNOTE_SEGMENTATION_BATCH_SIZE=6
# PYANNOTE_EMBEDDING_BATCH_SIZE=16

# Máquinas Vast.ai que no se deben volver a alquilar (p. ej. GPU ya ocupada por otro proceso).
# VAST_EXCLUDE_MACHINES=143557

# Credenciales de registro si la imagen es privada (Vast.ai las usa para el pull).
# REGISTRY_USERNAME=tuusuario
# REGISTRY_PASSWORD=dckr_pat_...
