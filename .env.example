# Copia este archivo a ".env" (ya está en .gitignore) y completa el token real.
# NUNCA pegues el token en el chat, en un commit ni en un script.

RADIO_BASE_URL=https://radio.datadaf.com
RADIO_API_TOKEN=reemplaza_con_tu_token_secreto
HF_TOKEN=reemplaza_con_tu_token_de_huggingface_read

# Opcionales. worker_transcripcion.py detecta el sistema operativo y elige
# defaults razonables solo: en macOS usa mlx/soniqo/cpu (mac-mini-luis-01),
# en Windows/Linux usa faster-whisper/pyannote/cuda (worker-<hostname>).
# Descomenta y ajusta solo si quieres forzar algo distinto al default:
# WORKER_ID=mac-mini-luis-01
# TRANSCRIPTION_ENGINE=mlx              # o faster-whisper
# WHISPER_MODEL=mlx-community/whisper-large-v3-mlx   # o large-v3
# DIARIZATION_ENGINE=soniqo             # o pyannote
# PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
# DEVICE=cpu                            # o cuda
# TRANSCRIPTION_LANGUAGE=es
# POLL_INTERVAL_SECONDS=15
# HEARTBEAT_INTERVAL_SECONDS=30

# Afinación Faster-Whisper/CTranslate2. El perfil local validado en una RTX
# 5060 Laptop de 8 GB usa 2 workers solo para las ventanas de reparación.
# WHISPER_DEVICE_INDEX=0               # varios GPU: 0,1 (requiere llamadas concurrentes)
# WHISPER_NUM_WORKERS=2
# WHISPER_BATCH_SIZE=0                 # 0: secuencial íntegro; >0: perfil por lotes
# BOUNDARY_REPAIR_WORKERS=2            # 1 revierte al modo original
