# Variante CUDA: por defecto 12.8 (driver >= 570). Para CUDA 13.0 (driver >= 580):
#   docker build --build-arg CUDA_IMAGE=13.0.2 --build-arg TORCH_CUDA=cu130 ...
ARG CUDA_IMAGE=12.8.1
FROM nvidia/cuda:${CUDA_IMAGE}-cudnn-runtime-ubuntu24.04
ARG TORCH_CUDA=cu128

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PATH=/opt/venv/bin:$PATH \
    HF_HOME=/workspace/huggingface MODELS_DIR=/workspace/modelos \
    RESULTS_DIR=/workspace/resultados_worker WORKER_TMP_DIR=/workspace/worker_tmp \
    DEVICE=cuda TRANSCRIPTION_ENGINE=faster-whisper DIARIZATION_ENGINE=pyannote

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv libpython3.12t64 ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3.12 -m venv /opt/venv
WORKDIR /opt/irixslave
COPY requirements.txt ./
# torchcodec se instala desde el índice de PyTorch con la misma variante CUDA
# que torch y en la versión que le corresponde (torchcodec 0.11 <-> torch 2.11);
# el de PyPI está compilado contra CUDA 13 y para otra versión de torch.
RUN pip install --upgrade pip setuptools wheel \
    && grep -v '^torchcodec' requirements.txt > /tmp/requirements-docker.txt \
    && pip install --extra-index-url https://download.pytorch.org/whl/${TORCH_CUDA} \
        torch==2.11.0+${TORCH_CUDA} torchaudio==2.11.0+${TORCH_CUDA} torchcodec==0.11.1+${TORCH_CUDA} \
        -r /tmp/requirements-docker.txt
COPY worker_transcripcion.py pipeline_transcripcion_diarizada.py motor_persistente.py ./
COPY scripts_originales/ ./scripts_originales/
COPY runpod_entrypoint.py ./
STOPSIGNAL SIGTERM
ENTRYPOINT ["python", "runpod_entrypoint.py"]
CMD ["--live", "--persistent-models"]
